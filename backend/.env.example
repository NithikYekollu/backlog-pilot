# TODO: Create a GitHub personal access token (classic) with "public_repo" scope.
#       Without this, unauthenticated requests are limited to 60/hour.
#       https://github.com/settings/tokens
GITHUB_TOKEN=

# TODO: Get your Devin API key from https://app.devin.ai/settings
#       Required for triage and fix sessions. Without it those features
#       return 503 but issue browsing still works.
DEVIN_API_KEY=

# TODO: Create a Slack Incoming Webhook at https://api.slack.com/messaging/webhooks
#       When set, triage completion auto-posts a summary to the configured Slack channel.
#       Without it, triage still works but Slack notifications are silently skipped.
SLACK_WEBHOOK_URL=
